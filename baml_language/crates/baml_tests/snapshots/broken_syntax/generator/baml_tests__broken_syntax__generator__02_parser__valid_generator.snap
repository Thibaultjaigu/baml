    QUOTE """
    DOT_DOT ".."
    SLASH "/"
    WORD "python"
    QUOTE """
    WORD "version"
    QUOTE """
    FLOAT_LITERAL "0.68"
    DOT "."
    INTEGER_LITERAL "0"
    QUOTE """
    WORD "naming_convention"
    QUOTE """
    WORD "preserve-case"
    QUOTE """
    R_BRACE "}"
  GENERATOR_DEF "generator lang_typescript {
  output_type typescript
  output_dir "../typescript"
  default_client_mode "async"
}"
