    WORD "MyClass"
    L_BRACE "{"
    FIELD
      WORD "name"
      TYPE_EXPR "string"
        WORD "string"
    FIELD
      WORD "age"
      TYPE_EXPR "int"
        WORD "int"
    R_BRACE "}"
  FUNCTION_DEF
